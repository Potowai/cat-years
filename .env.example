# --- Production (Vercel) ---
# Set automatically when you attach a Postgres (Neon) database to your Vercel project.
DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"

# Set automatically when you attach a Vercel Blob store to your Vercel project.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxx"

# --- Local development ---
# If you leave DATABASE_URL empty, the app automatically uses an embedded
# PGlite database stored in ./.pglite — zero setup required.
# If you leave BLOB_READ_WRITE_TOKEN empty, uploads are written to ./public/uploads.
